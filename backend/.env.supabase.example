# ============================================================
# HoneypotAI Backend — Supabase Production Environment
# Copy this to .env on your droplet and fill in your values
# ============================================================

HONEYPOT_SHARED_SECRET=your-strong-secret-here

# ---- Supabase (get from: Dashboard > Project Settings > Database) ----
# Use the "Session Pooler" URI (port 6543) for connection pooling
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Optional local SQLite fallback (used when DATABASE_URL is NOT set) ----
DATABASE_PATH=data/honeypot_events.db

# ---- AI Service (internal, not used for external HTTP anymore) ----
AI_SERVICE_URL=http://127.0.0.1:9000/ai/score
AI_API_KEY=not-used

# ---- Chunk settings for batch processing ----
AI_CHUNK_SIZE=25
AI_CHUNK_PAUSE_MS=0
